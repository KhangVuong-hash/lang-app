# Sao chép thành .env (local) hoặc đặt trong Environment Variables của Vercel.
# Lấy từ Supabase Dashboard → Project Settings → API.

# Công khai (nhúng vào client) — an toàn để lộ
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# BÍ MẬT — chỉ dùng phía server (Route Handler). KHÔNG commit, KHÔNG prefix NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
